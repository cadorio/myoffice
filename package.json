{
  "name": "myoffice",
  "version": "1.4.0",
  "private": true,
  "description": "Suite de escritório leve para Windows com assistente de IA local: texto, folhas de cálculo e apresentações.",
  "main": "main.js",
  "author": {
    "name": "cadorio",
    "email": "cadorio@users.noreply.github.com"
  },
  "homepage": "https://github.com/cadorio/myoffice",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/formula.test.js && node test/assistant.test.js && node test/license.test.js && node test/ai-download.test.js && node test/package-metadata.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "notices": "node tools/notices.js",
    "license": "node tools/license.js"
  },
  "build": {
    "appId": "com.github.cadorio.myoffice",
    "productName": "MyOffice",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "ai.js",
      "ai-worker.mjs",
      "ai-download.js",
      "license.js",
      "license-public.pem",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "!node_modules/@node-llama-cpp/*-cuda*/**",
      "!node_modules/@node-llama-cpp/*-vulkan*/**",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**",
      "!node_modules/node-llama-cpp/docs/**"
    ],
    "fileAssociations": [
      {
        "ext": "modoc",
        "name": "Documento MyOffice",
        "description": "Documento de texto MyOffice",
        "role": "Editor"
      },
      {
        "ext": "mosheet",
        "name": "Folha de cálculo MyOffice",
        "description": "Folha de cálculo MyOffice",
        "role": "Editor"
      },
      {
        "ext": "moslides",
        "name": "Apresentação MyOffice",
        "description": "Apresentação MyOffice",
        "role": "Editor"
      },
      {
        "ext": "docx",
        "name": "Documento Word (MyOffice)",
        "description": "Abrir documentos Word com MyOffice Texto",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "Apresentação PowerPoint (MyOffice)",
        "description": "Abrir apresentações PowerPoint com MyOffice Diapositivos",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyOffice",
      "artifactName": "MyOffice-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ]
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3"
  },
  "desktopName": "myoffice.desktop",
  "dependencies": {
    "node-llama-cpp": "^3.22.3"
  }
}
