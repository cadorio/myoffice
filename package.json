{
  "name": "myoffice",
  "version": "1.9.0",
  "private": true,
  "description": "Suite de escritório local com texto, folhas de cálculo, apresentações, desenho vetorial e assistente independente.",
  "main": "main.js",
  "author": {
    "name": "cadorio",
    "email": "cadorio@users.noreply.github.com"
  },
  "homepage": "https://github.com/cadorio/myoffice",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node test/formula.test.js && node test/assistant.test.js && node test/license.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "notices": "node tools/notices.js",
    "train:ai": "node tools/train-ai.js",
    "license": "node tools/license.js",
    "test:ui": "node test/ui.test.cjs"
  },
  "build": {
    "appId": "com.github.cadorio.myoffice",
    "productName": "MyOffice",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "ai.js",
      "license.js",
      "license-public.pem",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "modoc",
        "name": "Documento MyOffice",
        "description": "Documento de texto MyOffice",
        "role": "Editor"
      },
      {
        "ext": "mosheet",
        "name": "Folha de cálculo MyOffice",
        "description": "Folha de cálculo MyOffice",
        "role": "Editor"
      },
      {
        "ext": "moslides",
        "name": "Apresentação MyOffice",
        "description": "Apresentação MyOffice",
        "role": "Editor"
      },
      {
        "ext": "modraw",
        "name": "Desenho MyOffice",
        "description": "Diagrama vetorial MyOffice",
        "role": "Editor"
      },
      {
        "ext": "docx",
        "name": "Documento Word (MyOffice)",
        "description": "Abrir documentos Word com MyOffice Texto",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "Apresentação PowerPoint (MyOffice)",
        "description": "Abrir apresentações PowerPoint com MyOffice Diapositivos",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyOffice",
      "artifactName": "MyOffice-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "license": "LICENSE"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3"
  },
  "desktopName": "myoffice.desktop"
}
