{
  "name": "myoffice",
  "version": "1.12.1",
  "private": true,
  "description": "Suite de escritório local com texto, folhas de cálculo, apresentações, desenho vetorial e assistente independente.",
  "main": "main.js",
  "author": {
    "name": "cadorio",
    "email": "cadorio@users.noreply.github.com"
  },
  "homepage": "https://github.com/cadorio/myoffice",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node test/formula.test.js && node test/assistant.test.js && node test/license.test.js && node test/dbserver.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "notices": "node tools/notices.js",
    "train:ai": "node tools/train-ai.js",
    "license": "node tools/license.js",
    "test:ui": "node test/ui.test.cjs"
  },
  "build": {
    "appId": "com.github.cadorio.myoffice",
    "productName": "MyOffice",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "ai.js",
      "dbserver.js",
      "license.js",
      "license-public.pem",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "modoc",
        "name": "Documento MyOffice",
        "description": "Documento de texto MyOffice",
        "role": "Editor"
      },
      {
        "ext": "mosheet",
        "name": "Folha de cálculo MyOffice",
        "description": "Folha de cálculo MyOffice",
        "role": "Editor"
      },
      {
        "ext": "moslides",
        "name": "Apresentação MyOffice",
        "description": "Apresentação MyOffice",
        "role": "Editor"
      },
      {
        "ext": "modraw",
        "name": "Desenho MyOffice",
        "description": "Diagrama vetorial MyOffice",
        "role": "Editor"
      },
      {
        "ext": "docx",
        "name": "Documento Word (MyOffice)",
        "description": "Abrir documentos Word com MyOffice Texto",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "Apresentação PowerPoint (MyOffice)",
        "description": "Abrir apresentações PowerPoint com MyOffice Diapositivos",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "Documento PDF (MyOffice)",
        "description": "Abrir documentos PDF com MyOffice PDF",
        "role": "Editor"
      },
      {
        "ext": "modb",
        "name": "Base de dados MyOffice",
        "description": "Base de dados MyOffice (tabelas, formulários e consultas)",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "MyOffice",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "MyOffice",
      "artifactName": "MyOffice-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "license": "LICENSE",
      "language": "2070",
      "installerLanguages": [
        "pt_PT"
      ],
      "multiLanguageInstaller": false,
      "uninstallDisplayName": "MyOffice ${version}",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "copyright": "Copyright © 2025-2026 MyOffice. Licença Apache 2.0.",
    "msi": {
      "oneClick": true,
      "perMachine": true,
      "upgradeCode": "7d3c5a1e-4b2f-4e8a-9c61-2f0b8e5d4a37",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyOffice",
      "menuCategory": "MyOffice",
      "runAfterFinish": false,
      "artifactName": "MyOffice-${version}-x64.msi"
    },
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "*.ico"
        ]
      }
    ]
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.3",
    "mdb-reader": "3.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "sql.js": "1.16.0"
  },
  "desktopName": "myoffice.desktop",
  "dependencies": {
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "tedious": "20.3.9"
  }
}
